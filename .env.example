# ==============================================================================
# CLOUDFLARE PAGES ENVIRONMENT VARIABLES (Secret Server Side)
# Configure these in Cloudflare Pages Dashboard -> Settings -> Environment Variables
# ==============================================================================

# Gemini AI API Key (Server side - never exposed to browser)
GEMINI_API_KEY=

# Light Account Master Guest Account & Posting Key (Server side)
GUEST_ACCOUNT=hive.micro
GUEST_POSTING_KEY=

# Hive Account Creator Account & Active Key (Server side)
CREATOR_ACCOUNT=
CREATOR_ACTIVE_KEY=

# ==============================================================================
# CLIENT-SIDE LOCAL FALLBACKS (Only used if serverless function is not deployed)
# ==============================================================================
VITE_GUEST_ACCOUNT=hive.micro
VITE_GUEST_POSTING_KEY=
VITE_CREATOR_ACCOUNT=
VITE_CREATOR_ACTIVE_KEY=

